# ==============================================================================
# Telemetry Apps Ecosystem - Environment Configuration
# ==============================================================================

# Central Telemetry API URL (Backend Axum/PostgreSQL server). Must end in /api/v1.
TELEMETRY_API_URL=http://localhost:8080/api/v1
ADMIN_API_URL=http://localhost:8080/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# Worker Agent
# Seconds between flushes. Role, organization, work hours and consent come from the server
# after enrollment (WORKER_ROLE / WORKER_ORGANIZATION were removed in AGENT-08).
WORKER_FLUSH_INTERVAL=30

# Admin Security Configuration
ADMIN_AUTO_LOCK_MINUTES=5

# Google sign-in for the desktop admin app (TASK-ADMIN-10). OAuth client of type
# "Desktop app" in Google Cloud Console. Its client id must also be listed in the API's
# GOOGLE_CLIENT_ID (comma-separated with the web portal's id). Google does not treat the
# secret of an installed-app client as confidential; the token endpoint still requires it.
# Leave empty to disable the "Continuar con Google" button.
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
