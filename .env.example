# ==============================================================================
# Telemetry Apps Ecosystem - Environment Configuration
# ==============================================================================

# Central Telemetry API URL (Backend Axum/PostgreSQL server)
TELEMETRY_API_URL=http://localhost:8080/api/v1
ADMIN_API_URL=http://localhost:8080/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# Worker Agent Defaults
WORKER_ROLE=OFFICE
WORKER_FLUSH_INTERVAL=30
WORKER_ORGANIZATION=Acme SpA

# Admin Security Configuration
ADMIN_AUTO_LOCK_MINUTES=5
ADMIN_KEYSTORE_SERVICE_NAME=telemetry_admin_vault
