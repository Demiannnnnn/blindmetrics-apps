# Telemetry Admin Console
# Server the admin app is built for. Read at COMPILE time by src-tauri/build.rs and embedded in
# the binary (not exposed to the WebView): the sign-in screen never asks for a server address.
# Required for release builds and must be https://. Debug builds default to the local API.
TELEMETRY_API_URL=https://api.example.cl/api/v1
